# Sustituye los valores de ejemplo según tu instalación local de PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Copia la clave de Groq aquí en tu archivo local .env. No la compartas ni la subas a Git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Secreto aleatorio para firmar las sesiones de Flask. Define un valor propio localmente.
SECRET_KEY=

# Actívalo cuando la aplicación se sirva detrás de HTTPS.
SESSION_COOKIE_SECURE=false
